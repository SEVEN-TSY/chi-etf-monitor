{
  "name": "etf-share-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && vite preview --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "collect": "python ../monitor.py"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "hono": "^4.13.13",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
